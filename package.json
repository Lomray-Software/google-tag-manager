{
  "name": "@lomray/google-tag-manager",
  "version": "1.0.0",
  "description": "Google Tag manager service.",
  "type": "module",
  "keywords": [
    "js",
    "google",
    "plugin",
    "react",
    "tag",
    "manager",
    "gtm",
    "analytics"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lomray-Software/google-tag-manager.git"
  },
  "bugs": {
    "url": "https://github.com/Lomray-Software/google-tag-manager/issues"
  },
  "homepage": "https://github.com/Lomray-Software/google-tag-manager",
  "author": "Mikhail Yarmaliuk",
  "license": "MIT",
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c -w",
    "release": "npm run build && cd lib && npm publish",
    "lint:check": "eslint \"src/**/*.{ts,tsx,*.ts,*tsx}\"",
    "lint:format": "eslint --fix \"src/**/*.{ts,tsx,*.ts,*tsx}\"",
    "ts:check": "tsc --project ./tsconfig.json --skipLibCheck --noemit",
    "test": "vitest run",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@lomray/eslint-config-react": "^5.0.6",
    "@lomray/prettier-config": "^2.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@testing-library/react": "^16.0.1",
    "@types/chai": "^5.0.1",
    "@types/sinon": "^17.0.3",
    "@types/sinon-chai": "^4.0.0",
    "@vitest/coverage-v8": "^2.1.4",
    "@zerollup/ts-transform-paths": "^1.7.18",
    "chai": "^5.1.2",
    "eslint": "^8.57.1",
    "husky": "^9.1.6",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "rollup": "^4.24.3",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-ts": "^3.4.5",
    "semantic-release": "^24.2.0",
    "sinon": "^19.0.2",
    "sinon-chai": "^4.0.0",
    "typescript": "^5.3.3",
    "vitest": "^2.1.4"
  }
}
